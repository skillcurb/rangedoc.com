# ─────────────────────────────────────────────────────────────
# RangeDoc environment variables. Copy to ".env" and fill in.
# ─────────────────────────────────────────────────────────────

# MySQL / MariaDB connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# cPanel (MariaDB) example: mysql://cpuser_rdadmin:PASSWORD@localhost:3306/cpuser_rangedoc
# URL-encode special characters in the password (@ → %40, # → %23).
# Create the database with: CREATE DATABASE rangedoc CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL="mysql://root:password@localhost:3306/rangedoc"

# Public URL of the site (used for SEO canonical URLs, sitemap, payment return URLs, emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Long random string used to sign login sessions (run: openssl rand -base64 48)
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Where uploaded media is stored on disk (relative to the project root or absolute)
UPLOAD_DIR="storage/uploads"

# First admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@rangedoc.com"
SEED_ADMIN_PASSWORD="Admin@12345"

# NOTE: Payment keys (Stripe / PayPal), SMTP email and Google reCAPTCHA keys
# are managed from Admin → Settings, so you can change them without redeploying.

# Optional: max MySQL connections in the pool (default 10)
# DATABASE_POOL_SIZE=10
