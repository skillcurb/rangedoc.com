{
  "name": "rangedoc",
  "version": "1.0.0",
  "private": true,
  "description": "RangeDoc - find licensed Physical Therapists & Chiropractors near you. Next.js + Drizzle ORM + MySQL.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "setup": "drizzle-kit migrate && tsx src/db/seed.ts"
  },
