    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "drizzle-orm": "0.45.3",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
